<style>
/* ── Reset ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── Tokens ── */
:root {
  --blue-900: #042C53;
  --blue-800: #0C447C;
  --blue-700: #185FA5;
  --blue-600: #378ADD;
  --blue-200: #85B7EB;
  --blue-100: #B5D4F4;
  --blue-50:  #E6F1FB;
  --green-700: #3B6D11;
  --green-600: #639922;
  --green-200: #C0DD97;
  --green-50:  #EAF3DE;
  --red-700:   #791F1F;
  --red-600:   #A32D2D;
  --red-400:   #E24B4A;
  --red-50:    #FCEBEB;
  --gray-900: #1a1a1a;
  --gray-700: #3a3a3a;
  --gray-500: #6b6b6b;
  --gray-300: #c4c4c4;
  --gray-100: #f0f2f5;
  --gray-50:  #f7f8fa;
  --white: #ffffff;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
  --shadow-md: 0 4px 16px rgba(0,0,0,.10);
}

/* ── Base ── */
body {
  font-family: 'Noto Sans KR', sans-serif;
  font-size: 15px;
  color: var(--gray-900);
  background: var(--gray-100);
  min-height: 100vh;
}

/* ── Header ── */
.site-header {
  background: var(--blue-800);
  padding: 0 24px;
}
.header-inner {
  max-width: 780px;
  margin: 0 auto;
  padding: 20px 0 18px;
  display: flex;
  align-items: center;
  gap: 14px;
}
.header-icon {
  width: 40px; height: 40px;
  background: var(--blue-700);
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.header-icon i { font-size: 20px; color: var(--blue-100); }
.header-text {}
.header-eyebrow {
  font-size: 11px;
  color: var(--blue-200);
  letter-spacing: .06em;
  margin-bottom: 3px;
}
.header-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.3;
}
.header-badge {
  margin-left: auto;
  background: var(--blue-700);
  color: var(--blue-100);
  font-size: 11px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: 20px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ── Main ── */
.main {
  max-width: 780px;
  margin: 0 auto;
  padding: 28px 24px 60px;
}

/* ── Tabs ── */
.tabs {
  display: flex;
  gap: 0;
  border-bottom: 2px solid var(--gray-300);
  margin-bottom: 24px;
}
.tab {
  padding: 10px 20px;
  font-family: 'Noto Sans KR', sans-serif;
  font-size: 14px;
  font-weight: 500;
  color: var(--gray-500);
  background: none;
  border: none;
  border-bottom: 3px solid transparent;
  margin-bottom: -2px;
  cursor: pointer;
  transition: color .15s;
  display: flex;
  align-items: center;
  gap: 6px;
}
.tab i { font-size: 16px; }
.tab:hover { color: var(--blue-700); }
.tab.active {
  color: var(--blue-700);
  border-bottom-color: var(--blue-700);
}

/* ── Panels ── */
.pane { display: none; }
.pane.active { display: block; }

/* ── Card ── */
.card {
  background: var(--white);
  border-radius: var(--radius-lg);
  border: 1px solid #dde3ec;
  box-shadow: var(--shadow-sm);
  padding: 24px;
  margin-bottom: 16px;
}

/* ── Section label ── */
.section-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--blue-700);
  letter-spacing: .08em;
  text-transform: uppercase;
  margin-bottom: 10px;
}

/* ── ISBN input row ── */
.isbn-row {
  display: flex;
  gap: 10px;
  align-items: stretch;
}
.isbn-input-wrap {
  flex: 1;
  position: relative;
}
.isbn-input-wrap i {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 18px;
  color: var(--gray-300);
  pointer-events: none;
}
#isbn-input {
  width: 100%;
  height: 50px;
  padding: 0 14px 0 40px;
  font-family: 'Courier New', monospace;
  font-size: 17px;
  letter-spacing: .1em;
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  outline: none;
  transition: border-color .15s, box-shadow .15s;
  color: var(--gray-900);
}
#isbn-input:focus {
  border-color: var(--blue-600);
  box-shadow: 0 0 0 3px rgba(55,138,221,.15);
}
#isbn-input::placeholder { color: var(--gray-300); letter-spacing: .05em; }

.check-btn {
  height: 50px;
  padding: 0 26px;
  background: var(--blue-700);
  color: var(--white);
  font-family: 'Noto Sans KR', sans-serif;
  font-size: 14px;
  font-weight: 700;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: background .15s, transform .1s;
}
.check-btn:hover { background: var(--blue-800); }
.check-btn:active { transform: scale(.98); }
.check-btn i { font-size: 17px; }

/* ── Digit Strip ── */
.strip-wrap {
  margin: 20px 0 0;
}
.strip-title {
  font-size: 11px;
  color: var(--gray-500);
  margin-bottom: 8px;
}
.digit-strip {
  display: flex;
  gap: 5px;
  align-items: flex-end;
}
.digit-box {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.d-label {
  font-size: 10px;
  font-weight: 500;
  color: var(--gray-500);
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.d-char {
  font-family: 'Courier New', monospace;
  font-size: 16px;
  font-weight: 700;
  border-radius: var(--radius-sm);
  padding: 8px 4px;
  border: 1.5px solid var(--gray-300);
  background: var(--gray-50);
  color: var(--gray-500);
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s, color .2s, border-color .2s;
}
.d-char.hit {
  background: var(--blue-50);
  color: var(--blue-800);
  border-color: var(--blue-200);
}
.d-char.ok-green {
  background: var(--green-50);
  color: var(--green-700);
  border-color: var(--green-200);
}
.d-char.miss {
  background: var(--red-50);
  color: var(--red-600);
  border-color: #f09595;
}
.digit-sep {
  font-size: 22px;
  color: var(--gray-300);
  align-self: center;
  padding-bottom: 2px;
  flex-shrink: 0;
}

/* ── Result Card ── */
.result-card {
  border-radius: var(--radius-lg);
  border: 1.5px solid var(--gray-300);
  padding: 20px 22px;
  background: var(--gray-50);
  margin-bottom: 0;
  transition: border-color .2s, background .2s;
}
.result-card.pass {
  background: var(--green-50);
  border-color: var(--green-200);
}
.result-card.fail {
  background: var(--red-50);
  border-color: #f09595;
}
.result-head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.result-status-icon {
  width: 36px; height: 36px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-size: 18px;
}
.result-card.idle   .result-status-icon { background: var(--gray-100); }
.result-card.pass   .result-status-icon { background: var(--green-200); }
.result-card.fail   .result-status-icon { background: #f7c1c1; }
.result-title {
  font-size: 16px;
  font-weight: 700;
}
.result-card.idle .result-title { color: var(--gray-500); }
.result-card.pass .result-title { color: var(--green-700); }
.result-card.fail .result-title { color: var(--red-700); }

/* ── Check list ── */
.check-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.check-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 13.5px;
  line-height: 1.5;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,.7);
}
.check-item.item-ok { border-left: 3px solid var(--green-600); }
.check-item.item-ng { border-left: 3px solid var(--red-400); }
.ci-icon {
  font-size: 17px;
  margin-top: 1px;
  flex-shrink: 0;
}
.item-ok .ci-icon { color: var(--green-600); }
.item-ng .ci-icon { color: var(--red-400); }
.ci-label {
  font-weight: 700;
  color: var(--gray-900);
  display: block;
}
.ci-sub {
  font-size: 12px;
  color: var(--gray-500);
  display: block;
  margin-top: 2px;
}

/* ── Hint ── */
.hint {
  font-size: 12px;
  color: var(--gray-500);
  margin-top: 14px;
  line-height: 1.7;
  display: flex;
  align-items: flex-start;
  gap: 6px;
}
.hint i { font-size: 14px; margin-top: 1px; flex-shrink: 0; }
code {
  font-family: 'Courier New', monospace;
  background: var(--blue-50);
  color: var(--blue-800);
  padding: 1px 5px;
  border-radius: 4px;
  font-size: 12px;
}

/* ── Batch ── */
#batch-input {
  width: 100%;
  font-family: 'Courier New', monospace;
  font-size: 13px;
  line-height: 1.8;
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  resize: vertical;
  min-height: 100px;
  outline: none;
  color: var(--gray-900);
}
#batch-input:focus {
  border-color: var(--blue-600);
  box-shadow: 0 0 0 3px rgba(55,138,221,.15);
}
.batch-actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}
.btn-primary {
  flex: 1;
  height: 44px;
  background: var(--blue-700);
  color: var(--white);
  font-family: 'Noto Sans KR', sans-serif;
  font-size: 14px;
  font-weight: 700;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: background .15s;
}
.btn-primary:hover { background: var(--blue-800); }
.btn-secondary {
  height: 44px;
  padding: 0 18px;
  background: var(--white);
  color: var(--gray-700);
  font-family: 'Noto Sans KR', sans-serif;
  font-size: 14px;
  font-weight: 500;
  border: 1.5px solid var(--gray-300);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: border-color .15s;
}
.btn-secondary:hover { border-color: var(--gray-500); }

.batch-summary {
  display: flex;
  gap: 16px;
  margin: 14px 0 10px;
  font-size: 13px;
  font-weight: 500;
}
.batch-summary .s-total { color: var(--gray-500); }
.batch-summary .s-pass  { color: var(--green-700); }
.batch-summary .s-fail  { color: var(--red-600); }
.batch-summary .s-err   { color: var(--gray-500); }

.batch-table {
  width: 100%;
  border-collapse: collapse;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid #dde3ec;
  font-size: 13px;
}
.batch-table th {
  background: var(--blue-50);
  color: var(--blue-800);
  font-weight: 700;
  font-size: 11px;
  text-align: left;
  padding: 9px 14px;
  letter-spacing: .04em;
  border-bottom: 1px solid #dde3ec;
}
.batch-table td {
  padding: 9px 14px;
  border-bottom: 1px solid #f0f2f5;
  vertical-align: middle;
}
.batch-table tr:last-child td { border-bottom: none; }
.batch-table tr.r-pass { background: #f4fbec; }
.batch-table tr.r-fail { background: #fff5f5; }
.batch-table tr.r-pass td { color: var(--green-700); }
.batch-table tr.r-fail td { color: var(--red-700); }
.batch-table tr.r-err td  { color: var(--gray-500); }
.batch-table td.isbn-col { font-family: 'Courier New', monospace; font-size: 12px; }
.badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 20px;
}
.badge.b-pass { background: var(--green-600); color: #fff; }
.badge.b-fail { background: var(--red-600); color: #fff; }
.badge.b-err  { background: var(--gray-300); color: var(--gray-700); }

/* ── Guide pane ── */
.guide-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media(max-width:600px){ .guide-grid { grid-template-columns: 1fr; } }
.guide-card {
  background: var(--white);
  border: 1px solid #dde3ec;
  border-radius: var(--radius-md);
  padding: 18px;
}
.guide-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--gray-100);
}
.guide-card-head i { font-size: 20px; color: var(--blue-700); }
.guide-card-head strong { font-size: 14px; font-weight: 700; color: var(--gray-900); }
.guide-card-head span { font-size: 11px; color: var(--gray-500); display: block; margin-top: 1px; }
.guide-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  padding: 5px 0;
  font-size: 13px;
  border-bottom: 1px solid var(--gray-100);
}
.guide-row:last-child { border-bottom: none; }
.guide-code {
  font-family: 'Courier New', monospace;
  font-size: 13px;
  font-weight: 700;
  width: 22px;
  flex-shrink: 0;
  text-align: center;
}
.guide-row.allowed .guide-code { color: var(--blue-700); }
.guide-row.blocked .guide-code { color: var(--red-400); }
.guide-desc { color: var(--gray-700); flex: 1; }
.guide-pill {
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 20px;
  font-weight: 700;
  flex-shrink: 0;
}
.guide-pill.ok { background: var(--blue-50); color: var(--blue-800); }
.guide-pill.ng { background: var(--red-50); color: var(--red-600); }

.content-guide { margin-top: 14px; }
.content-guide-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 12px;
  border-radius: var(--radius-sm);
  margin-bottom: 4px;
  font-size: 13px;
}
.content-guide-row.ok-row { background: var(--blue-50); }
.content-guide-row.ng-row { background: var(--red-50); }
.content-guide-row .range-code {
  font-family: 'Courier New', monospace;
  font-size: 12px;
  font-weight: 700;
  width: 80px;
  flex-shrink: 0;
}
.ok-row .range-code { color: var(--blue-800); }
.ng-row .range-code { color: var(--red-600); }
.ok-row .range-label { color: var(--blue-900); }
.ng-row .range-label { color: var(--red-700); }

/* ── Mobile tweaks ── */
@media(max-width: 480px) {
  .header-title { font-size: 15px; }
  .header-badge { display: none; }
  .isbn-row { flex-direction: column; }
  .check-btn { width: 100%; justify-content: center; }
  .tab { padding: 10px 12px; font-size: 13px; }
  .tab span.tab-text { display: none; }
  .digit-strip { flex-wrap: wrap; gap: 4px; }
}

/* ── Disclaimer ── */
.disclaimer {
  max-width: 780px;
  margin: 0 auto;
  padding: 0 24px 40px;
}
.disclaimer-inner {
  border-top: 1px solid var(--gray-300);
  padding-top: 16px;
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  color: var(--gray-500);
  line-height: 1.7;
}
.disclaimer-inner i { font-size: 14px; margin-top: 2px; flex-shrink: 0; color: var(--gray-300); }
.disclaimer-inner a { color: var(--blue-700); text-decoration: none; }
.disclaimer-inner a:hover { text-decoration: underline; }

/* ── Footer ── */
.site-footer {
  background: var(--blue-900);
  padding: 24px;
  text-align: center;
}
.site-footer p {
  font-size: 12px;
  color: var(--blue-200);
  line-height: 1.8;
}
.site-footer a {
  color: var(--blue-100);
  text-decoration: none;
}
.site-footer a:hover { text-decoration: underline; }
</style>
</head>
<body>

<header class="site-header">
  <div class="header-inner">
    <div class="header-icon">
      <i class="ti ti-scan" aria-hidden="true"></i>
    </div>
    <div class="header-text">
      <div class="header-eyebrow"</div>
      <div class="header-title">청년문화예술패스 도서 지원 대상 확인</div>
    </div>
    <span class="header-badge">2026년 기준</span>
  </div>
</header>

<main class="main">
  <div class="tabs" role="tablist">
    <button class="tab active" role="tab" aria-selected="true" onclick="switchTab('single',this)">
      <i class="ti ti-barcode" aria-hidden="true"></i> <span class="tab-text">단권 확인</span>
    </button>
    <button class="tab" role="tab" aria-selected="false" onclick="switchTab('batch',this)">
      <i class="ti ti-list-check" aria-hidden="true"></i> <span class="tab-text">일괄 확인</span>
    </button>
    <button class="tab" role="tab" aria-selected="false" onclick="switchTab('guide',this)">
      <i class="ti ti-info-circle" aria-hidden="true"></i> <span class="tab-text">분류 기준</span>
    </button>
  </div>

  <!-- 단권 확인 -->
  <div id="pane-single" class="pane active" role="tabpanel">
    <div class="card">
      <div class="section-label">ISBN 입력</div>
      <div class="isbn-row">
        <div class="isbn-input-wrap">
          <i class="ti ti-barcode" aria-hidden="true"></i>
          <input type="text" id="isbn-input" maxlength="22"
            placeholder="9791162540000 03810"
            aria-label="ISBN 13자리와 부가기호 5자리 입력"
            oninput="onInput()" onkeydown="if(event.key==='Enter')check()" />
        </div>
        <button class="check-btn" onclick="check()" aria-label="확인">
          <i class="ti ti-search" aria-hidden="true"></i> 확인
        </button>
      </div>

      <div class="strip-wrap">
        <div class="strip-title">도서번호 분석 — ISBN 13자리 + 부가기호 5자리</div>
        <div class="digit-strip">
          <div class="digit-box" style="flex:5;min-width:0">
            <div class="d-label">ISBN 13자리</div>
            <div class="d-char" id="d-isbn">— — — — — — — — — — — — —</div>
