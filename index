<script>
const READER_ALLOW = new Set(['0','9']);
const FORMAT_BLOCK = new Set(['1','5']);
const CONTENT_RANGES = [
  [0,9,'총류 일반'],[40,49,'강연집·수필집·연설문집'],
  [100,190,'철학·심리학·윤리학'],[200,290,'종교'],
  [300,309,'사회과학 일반'],[380,389,'풍습·민속학·예절'],
  [600,690,'예술'],[700,709,'언어 일반'],
  [800,890,'문학'],[900,990,'역사'],
];
const R1MAP = {'0':'교양','1':'실용','2':'(예비)','3':'(예비)','4':'청소년','5':'참고서(중·고)','6':'참고서(초등)','7':'아동','8':'(예비)','9':'전문'};
const R2MAP = {'0':'문고본','1':'사전','2':'신서판','3':'단행본','4':'전집·총서','5':'전자출판물','6':'도감','7':'그림책·만화','8':'혼합자료'};

function parseISBN(raw) {
  const d = raw.replace(/[\s\-]/g,'');
  if (d.length !== 18) return null;
  return { isbn:d.slice(0,13), d1:d[13], d2:d[14], d3:parseInt(d.slice(15),10), d3raw:d.slice(15) };
}

function getContentLabel(n) {
  for (const [lo,hi,label] of CONTENT_RANGES) if (n>=lo && n<=hi) return label;
  return null;
}

function evaluate(p) {
  const r1ok = READER_ALLOW.has(p.d1);
  const r2ok = !FORMAT_BLOCK.has(p.d2);
  const label = getContentLabel(p.d3);
  const r3ok = !!label;
  return {
    pass: r1ok && r2ok && r3ok,
    checks: [
      { ok:r1ok, label:`독자대상 (${p.d1}) — ${R1MAP[p.d1]||'기타'}`, sub: r1ok ? '허용 대상입니다 (교양·전문)' : '교양(0) 또는 전문(9)만 허용됩니다' },
      { ok:r2ok, label:`발행형태 (${p.d2}) — ${R2MAP[p.d2]||'기타'}`, sub: r2ok ? '허용 형태입니다' : '사전(1)과 전자출판물(5)은 제외됩니다' },
      { ok:r3ok, label:`내용분류 (${p.d3raw}) — ${r3ok ? label : '지원 외 분야'}`, sub: r3ok ? '허용 범위에 포함됩니다' : '철학·종교·예술·문학·역사·총류·사회과학일반·언어일반 범위만 허용됩니다' },
    ]
  };
}

function resetStrip() {
  document.getElementById('d-isbn').className='d-char';
  document.getElementById('d-isbn').textContent='— — — — — — — — — — — — —';
  ['d1','d2','d3'].forEach(id => {
    document.getElementById(id).className='d-char';
    document.getElementById(id).textContent='–';
  });
}

function check() {
  const raw = document.getElementById('isbn-input').value;
  const p = parseISBN(raw);
  const card = document.getElementById('result-card');
  const icon = document.getElementById('result-icon');
  const title = document.getElementById('result-title');
  const list = document.getElementById('check-list');

  if (!p) {
    resetStrip();
    card.className='result-card idle';
    icon.className='ti ti-clipboard-text';
    title.textContent='ISBN 18자리를 입력해 주세요 (13자리 + 부가기호 5자리)';
    list.innerHTML='';
    return;
  }

  const result = evaluate(p);

  document.getElementById('d-isbn').textContent = p.isbn;
  document.getElementById('d-isbn').className = 'd-char hit';

  const ids=['d1','d2','d3'], oks=[result.checks[0].ok, result.checks[1].ok, result.checks[2].ok];
  const vals=[p.d1, p.d2, p.d3raw];
  ids.forEach((id,i) => {
    document.getElementById(id).textContent = vals[i];
    document.getElementById(id).className = 'd-char ' + (oks[i] ? 'ok-green' : 'miss');
  });

  card.className = 'result-card ' + (result.pass ? 'pass' : 'fail');
  icon.className = result.pass ? 'ti ti-circle-check' : 'ti ti-circle-x';
  title.textContent = result.pass ? '구매 가능 — 청년문화예술패스 지원 대상 도서입니다' : '구매 불가 — 지원 대상 외 도서입니다';

  list.innerHTML = result.checks.map(c => `
    <li class="check-item ${c.ok ? 'item-ok' : 'item-ng'}">
      <i class="ci-icon ti ${c.ok ? 'ti-circle-check' : 'ti-circle-x'}" aria-hidden="true"></i>
      <span>
        <span class="ci-label">${c.label}</span>
        <span class="ci-sub">${c.sub}</span>
      </span>
    </li>`).join('');
}

function onInput() {
  if (document.getElementById('isbn-input').value.replace(/[\s\-]/g,'').length===18) check();
}

function switchTab(name, btn) {
  const tabs = document.querySelectorAll('.tab');
  const panes = ['single','batch','guide'];
  tabs.forEach((t, i) => {
    const active = panes[i] === name;
    t.classList.toggle('active', active);
    t.setAttribute('aria-selected', active);
    document.getElementById('pane-' + panes[i]).classList.toggle('active', active);
  });
}

function batchCheck() {
  const lines = document.getElementById('batch-input').value.split('\n').filter(l=>l.trim());
  if (!lines.length) return;

  const rows = lines.map(line => {
    const digits = line.replace(/[\s\-]/g,'');
    const p = parseISBN(digits.slice(0,18));
    const title = line.replace(/\d/g,'').replace(/[-\s]/g,'').trim() || '';
    if (!p) return { isbn:'—', title:line.trim().slice(0,20), pass:null, reason:'형식 오류' };
    const res = evaluate(p);
    const failReasons = res.checks.filter(c=>!c.ok).map(c=>c.label.split('—')[0].trim()).join(', ');
    return { isbn:p.isbn+' '+p.d1+p.d2+p.d3raw, title, pass:res.pass, reason: res.pass ? (title||'—') : failReasons };
  });

  const pc=rows.filter(r=>r.pass===true).length;
  const fc=rows.filter(r=>r.pass===false).length;
  const ec=rows.filter(r=>r.pass===null).length;

  let html = `<div class="batch-summary">
    <span class="s-total">총 ${rows.length}건</span>
    <span class="s-pass">✓ 구매 가능 ${pc}건</span>
    <span class="s-fail">✗ 구매 불가 ${fc}건</span>
    ${ec ? `<span class="s-err">⚠ 오류 ${ec}건</span>` : ''}
  </div>
  <table class="batch-table">
    <thead><tr>
      <th>ISBN + 부가기호</th>
      <th>서명·사유</th>
      <th style="text-align:right">결과</th>
    </tr></thead><tbody>`;

  rows.forEach(r => {
    const cls = r.pass===true?'r-pass':r.pass===false?'r-fail':'r-err';
    const badge = r.pass===true
      ? '<span class="badge b-pass">구매 가능</span>'
      : r.pass===false
        ? '<span class="badge b-fail">구매 불가</span>'
        : '<span class="badge b-err">형식 오류</span>';
    html += `<tr class="${cls}">
      <td class="isbn-col">${r.isbn}</td>
      <td>${r.reason||'—'}</td>
      <td style="text-align:right">${badge}</td>
    </tr>`;
  });

  html += '</tbody></table>';
  document.getElementById('batch-result').innerHTML = html;
}

function clearBatch() {
  document.getElementById('batch-input').value='';
  document.getElementById('batch-result').innerHTML='';
}
</script>
